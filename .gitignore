.impeccable/
.DS_Store

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# .env* above would swallow the committed template; keep it
!.env.example

# architect-advisor keeps two kinds of file side by side. The extracted patterns
# are shared knowledge and are committed; the run state is not. Both files below
# record the *worktree* name rather than the project, so committing them would
# have every worktree overwrite the others.
/architect-advisor/state/
/architect-advisor/.active

# Claude Code keeps shared and personal configuration side by side under
# .claude/. The shared half is committed — agents/, launch.json, and a
# settings.json if the team ever wants one. `settings.local.json` is the
# personal half by convention: one person's permission grants, which depend on
# what they run locally and are nobody else's to inherit.
/.claude/settings.local.json

# The ux-audit skill carries its own package.json so its Playwright driver can
# run from a checkout of this repo as well as from a personal ~/.claude install.
# The manifest and lockfile are committed; the install is not. `/node_modules`
# above is anchored to the repo root and would not have caught this one.
/.claude/skills/*/node_modules/
