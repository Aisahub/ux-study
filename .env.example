# The Neon branch that serves Learners.
DATABASE_URL=

# A separate Neon branch, used only by the test suite. Never point this at the
# branch above — the suite writes to it.
DATABASE_URL_TEST=

# The Google OAuth client for sign-in (#11). Created in the Google Cloud
# console as a "Web application" client with the deployment's origin as an
# authorised JavaScript origin and <origin>/api/auth/callback/google as an
# authorised redirect URI (plus http://localhost:3000 for development).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
